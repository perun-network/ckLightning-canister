type BtcAddressType = variant { P2WPKH; P2PKH; P2TR };
type BtcError = variant {
  BtcAddressFetchError : text;
  BtcCouldNotFetchBalance;
  Other : text;
};
type BtcPurpose = variant { LnInvoiceDeposit; LiquidityDepositor : principal };
type ChannelFunding = record { participant : blob; channel : blob };
type ChannelTime = record { time : nat64; chanid : blob };
type CklChannelAction = variant { Depositing; Idle; Withdrawing };
type CklError = variant {
  InvalidInput;
  InsufficientFunding;
  NotFinalized;
  InvalidSignature;
  OutdatedState;
  PubKeyMismatch;
  UnauthorizedCaller;
  LedgerError;
  Authentication;
  InvalidPubKey;
  AlreadyConcluded;
  InsufficientLiquidity;
  SignatureVerificationFailed;
  Other : text;
  NoHoldingsFound;
  ReceiverError : ICPReceiverError;
  ConfirmationError;
  SerializationError;
};
type Event = variant {
  Disputed : record { state : RegisteredState; timestamp : nat64 };
  Funded : record { who : blob; total : nat; timestamp : nat64 };
  Concluded : record { state : RegisteredState; timestamp : nat64 };
};
type Funding = variant { Pool : PoolFunding; Channel : ChannelFunding };
type FundingLPArgs = record { signature : blob; pool_funding : PoolFunding };
type FundingLPQuery = record {
  asset : PoolAsset;
  pubkey_l1 : blob;
  address : principal;
};
type FundingLPQueryArgs = record {
  funding_query_sig : blob;
  funding_query : FundingLPQuery;
};
type GetBtcBalancesResponse = record {
  msg : SetBtcAddressMsg;
  balances : vec record { principal; opt nat64 };
};
type HoldingsResponse = record { btc_amount : nat; ckbtc_amount : nat };
type ICPReceiverError = variant {
  TxMapNotFound;
  TxAmountNotFound;
  TxNotFound;
  TransactionType;
  FailedToQuery;
  TxFromNotFound;
  DuplicateTransaction;
  Recipient;
  TxToNotFound;
};
type LnInvoiceRequest = record {
  amount_msat : nat64;
  caller_principal : principal;
  btc_address : text;
};
type Network = variant { mainnet; regtest; testnet };
type NotifyArgs = record {
  amount : nat64;
  block_height : nat64;
  funding : Funding;
};
type PoolAsset = variant { BTC; CkBTC };
type PoolFunding = record {
  depositor : principal;
  asset : PoolAsset;
  pubkey_l1 : blob;
  timestamp : nat64;
};
type PoolWithdrawal = record {
  depositor : principal;
  asset : PoolAsset;
  pubkey_l1 : blob;
  amount : nat;
};
type RegEvent = record { time : nat64; event : Event; chanid : blob };
type RegisteredState = record { state : State; timeout : nat64 };
type Result = variant { Ok; Err : CklError };
type Result_1 = variant { Ok : GetBtcBalancesResponse; Err : BtcError };
type Result_2 = variant { Ok : text; Err : BtcError };
type Result_3 = variant { Ok : SignedCandidInvoice; Err : BtcError };
type Result_4 = variant { Ok : HoldingsResponse; Err : CklError };
type Result_5 = variant { Ok : SendBtcTxMsg; Err : BtcError };
type Result_6 = variant { Ok : SetBtcAddressResponse; Err : BtcError };
type Result_7 = variant { Ok : SetLiquidityBtcAddressResponse; Err : BtcError };
type Result_8 = variant {
  Ok : TransactionICRCNotification;
  Err : ICPReceiverError;
};
type Result_9 = variant { Ok : nat; Err : CklError };
type SendBtcTxArgs = record {
  recipient : text;
  from_address_type : BtcAddressType;
  amount : nat64;
};
type SendBtcTxMsg = variant { Fail; Success : text };
type SendRequest = record {
  destination_address : text;
  amount_in_satoshi : nat64;
};
type SetBtcAddressArgs = record {
  "principal" : opt principal;
  subaccount : opt blob;
  address_type : BtcAddressType;
};
type SetBtcAddressMsg = variant {
  BtcAddressesAvailable;
  BtcAddressSetNowSingle : BtcAddressType;
  BtcAddressNotSet;
  BtcAddressAlreadySetSingle : BtcAddressType;
  BtcAddressSetFailedSingle : BtcAddressType;
};
type SetBtcAddressResponse = record { msg : SetBtcAddressMsg; address : text };
type SetLiquidityBtcAddressResponse = record {
  already_existed : bool;
  address : text;
};
type SignedCandidInvoice = record {
  channel_id : blob;
  payment_hash : blob;
  signature : blob;
  invoice : text;
  amount_msat : opt nat;
  currency : text;
  expiry_secs : opt nat64;
  timestamp : nat64;
  payment_secret : blob;
};
type State = record {
  action : CklChannelAction;
  version : nat64;
  finalized : bool;
  remote_id : opt blob;
  allocation : vec nat;
  channel : blob;
};
type TransactionICRCNotification = record {
  to : blob;
  from : blob;
  memo : blob;
  timestamp : opt nat64;
  amount : nat64;
};
type WithdrawalLPArgs = record {
  signature : blob;
  pool_withdrawal : PoolWithdrawal;
};
type WithdrawalReq = record {
  participant : blob;
  channel : blob;
  amount : nat;
  receiver : principal;
};
service : (Network) -> {
  __candid_method_deposit_channel : (ChannelFunding, blob) -> (Result);
  __candid_method_deposit_lp : (FundingLPArgs) -> (Result);
  __candid_method_get_btc_balance : (opt nat64) -> (Result_1);
  __candid_method_get_btc_liquidity_address_for_caller : () -> (Result_2);
  __candid_method_get_ln_address : () -> (Result_2);
  __candid_method_query_events : (ChannelTime) -> (text) query;
  __candid_method_query_ln_invoice : (LnInvoiceRequest) -> (Result_3);
  __candid_method_query_state : (blob) -> (opt RegisteredState) query;
  // Returns the funds deposited for a channel's specified participant, if any.
  // this function should be used to check whether all participants have
  // deposited their owed funds into a channel to ensure it is fully funded.
  __candid_method_query_user_lp_holdings : (FundingLPQueryArgs) -> (
      Result_4,
    ) query;
  __candid_method_register_event : (blob, nat64, Event) -> ();
  __candid_method_register_event_isolated : (RegEvent) -> ();
  __candid_method_send_btc_tx : (SendBtcTxArgs) -> (Result_5);
  __candid_method_set_btc_address : (SetBtcAddressArgs) -> (Result_6);
  __candid_method_set_btc_liquidity_address : () -> (Result_7);
  __candid_method_simple_withdraw : (WithdrawalReq) -> (nat);
  __candid_method_transaction_notification : (NotifyArgs) -> (Result_8);
  __candid_method_trigger_withdraw : (WithdrawalReq) -> (Result_9);
  __candid_method_withdraw_lp : (WithdrawalLPArgs) -> (Result);
  clear : () -> ();
  deposit_channel : (ChannelFunding, blob) -> (Result);
  deposit_lp : (FundingLPArgs) -> (Result);
  dequeue : () -> (opt text);
  enqueue : (text) -> ();
  // Returns the balance of the given bitcoin address.
  get_balance : (text) -> (nat64);
  get_btc_balance : (opt nat64) -> (Result_1);
  get_btc_liquidity_address_for_caller : () -> (Result_2);
  get_ln_address : () -> (Result_2);
  // Returns a legacy P2PKH (Pay-to-PubKey-Hash) address for this smart contract.
  // 
  // This address uses an ECDSA public key and encodes it in the legacy Base58 format.
  // It is supported by all bitcoin wallets and full nodes.
  get_p2pkh_address : () -> (Result_2);
  // Returns a Taproot (P2TR) address of this smart contract that supports **key path spending only**.
  // 
  // This address does not commit to a script path (it commits to an unspendable path per BIP-341).
  // It allows spending using a single Schnorr signature corresponding to the internal key.
  get_p2tr_key_path_only_address : () -> (Result_2);
  get_p2wpkh_address : () -> (Result_2);
  get_segwit_address : (BtcPurpose) -> (Result_2);
  peek : () -> (opt text) query;
  query_events : (ChannelTime) -> (text) query;
  query_ln_invoice : (LnInvoiceRequest) -> (Result_3);
  query_state : (blob) -> (opt RegisteredState) query;
  // Returns the funds deposited for a channel's specified participant, if any.
  // this function should be used to check whether all participants have
  // deposited their owed funds into a channel to ensure it is fully funded.
  query_user_lp_holdings : (FundingLPQueryArgs) -> (Result_4) query;
  register_event : (blob, nat64, Event) -> ();
  register_event_isolated : (RegEvent) -> ();
  send_btc_tx : (SendBtcTxArgs) -> (Result_5);
  send_from_p2pkh_address : (SendRequest) -> (text);
  set_btc_address : (SetBtcAddressArgs) -> (Result_6);
  set_btc_liquidity_address : () -> (Result_7);
  simple_withdraw : (WithdrawalReq) -> (nat);
  size : () -> (nat64) query;
  transaction_notification : (NotifyArgs) -> (Result_8);
  trigger_withdraw : (WithdrawalReq) -> (Result_9);
  withdraw_lp : (WithdrawalLPArgs) -> (Result);
}
