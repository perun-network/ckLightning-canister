};
type CklError = variant {
  InvalidInput;
  InsufficientFunding;
  NotFinalized;
  InvalidSignature;
  OutdatedState;
  PubKeyMismatch;
  UnauthorizedCaller;
  LedgerError;
  Authentication;
  InvalidPubKey;
  AlreadyConcluded;
  InsufficientLiquidity;
  SignatureVerificationFailed;
  Other : text;
  NoHoldingsFound;
  ReceiverError : ICPReceiverError;
  ConfirmationError;
  SerializationError;
};
